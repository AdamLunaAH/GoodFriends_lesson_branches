{
    "Logging": {
        //All Logger providers
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        },
        "Console": {
            //Valid only for the console
            "LogLevel": {
                "Services": "Information",
                "AppWebApi.Controllers": "None",
                "DbRepos": "None"
            }
        },
        "InMemory": {
            //Valid only for the InMemory provider
            "LogLevel": {
                "Services": "Information",
                "AppWebApi.Controllers": "Information",
                "DbRepos": "Information"
            }
        }
    },

    "AllowedHosts": "*",

    "ApplicationSecrets": {
        "SecretStorage": "UserSecrets"
    },

    "DatabaseConnections": {
        "DefaultDataUser": "friend", //"gstusr" | "usr" | "supusr" | "dbo" | "friend"
        //   "MigrationUser": "friend",    //migration is done by friend user
        "UseDataSetWithTag": "Roomfinder.mysql" //"Roomfinder.sqlserver" | "Roomfinder.mysql" | "Roomfinder.postgresql"
    }
}
